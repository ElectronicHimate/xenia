{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Windows ARM64 Build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm64",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "XE_ARCH": "ARM64",
        "CMAKE_SYSTEM_PROCESSOR": "ARM64",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
    },
      "toolset": "host=arm64,arch=arm64"
    {
      "name": "vs",
      "displayName": "Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": "arm64",
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "checked",
      "displayName": "Checked",
      "configurePreset": "default",
      "configuration": "Checked"
    },
    {
      "name": "vs-debug",
      "configurePreset": "vs",
      "configuration": "Debug"
    },
    {
      "name": "vs-release",
      "configurePreset": "vs",
      "configuration": "Release"
    },
    {
      "name": "vs-checked",
      "configurePreset": "vs",
      "configuration": "Checked"
    }
  ]
}
